{
  "uid": "ec2-auto-discovery",
  "title": "🔍 EC2 Auto-Discovery",
  "description": "Live EC2 instances from AWS CloudWatch — updates every 5 minutes",
  "tags": ["ec2", "auto-discovery", "aws"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "1m",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [

    {
      "id": 1, "type": "row",
      "title": "📊 Live Instance Summary",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 2,
      "title": "🟢 Running Instances",
      "description": "Count of unique EC2 instances reporting to CloudWatch — only running instances report metrics",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": 0 },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "count(count by (instance_id) (max_over_time(aws_ec2_cpuutilization_average[10m]))) or vector(0)",
        "legendFormat": "Running"
      }]
    },

    {
      "id": 3,
      "title": "✅ Status Healthy",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": 0 },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "count(count by (instance_id) (max_over_time(aws_ec2_status_check_failed_sum[10m]) == 0)) or vector(0)",
        "legendFormat": "Healthy"
      }]
    },

    {
      "id": 4,
      "title": "❌ Status Failed",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "red",   "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "count(count by (instance_id) (max_over_time(aws_ec2_status_check_failed_sum[10m]) > 0)) or vector(0)",
        "legendFormat": "Failed"
      }]
    },

    {
      "id": 5,
      "title": "Avg CPU %",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "0",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": 0  },
            { "color": "yellow", "value": 70 },
            { "color": "red",    "value": 90 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "avg(avg by (instance_id) (max_over_time(aws_ec2_cpuutilization_average[10m]))) or vector(0)",
        "legendFormat": "Avg CPU"
      }]
    },

    {
      "id": 6,
      "title": "CloudWatch Status",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": 0 },
            { "color": "green", "value": 1 }
          ]},
          "mappings": [{
            "type": "value",
            "options": {
              "1": { "text": "🟢 Connected" },
              "0": { "text": "🔴 Down" }
            }
          }]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "up{job=\"cloudwatch\"}",
        "legendFormat": "CloudWatch"
      }]
    },

    {
      "id": 7,
      "title": "Auto-Discovery Agent",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": 0 },
            { "color": "green", "value": 1 }
          ]},
          "mappings": [{
            "type": "value",
            "options": {
              "1": { "text": "🟢 Running" },
              "0": { "text": "🔴 Down" }
            }
          }]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "up{job=\"auto-discovery\"}",
        "legendFormat": "Agent"
      }]
    },

    {
      "id": 10, "type": "row",
      "title": "🖥️ All Running EC2 Instances",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },

    {
      "id": 20,
      "title": "EC2 Instance Inventory — Live from AWS CloudWatch",
      "description": "Only running instances appear. Stopped instances disappear within 5 minutes of stopping.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [{ "displayName": "CPU %", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Health" },
            "properties": [
              { "id": "custom.width", "value": 140 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [{ "type": "value", "options": {
                "0": { "text": "🟢 Healthy",      "color": "green", "index": 0 },
                "1": { "text": "🔴 Check Failed", "color": "red",   "index": 1 }
              }}]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 100 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green",  "value": 0  },
                { "color": "yellow", "value": 70 },
                { "color": "red",    "value": 90 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Network In" },
            "properties": [{ "id": "unit", "value": "bytes" }, { "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "Network Out" },
            "properties": [{ "id": "unit", "value": "bytes" }, { "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "Instance ID" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      },
      "targets": [
        {
          "refId": "CPU",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "avg by (instance_id) (max_over_time(aws_ec2_cpuutilization_average[10m]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "Health",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "max by (instance_id) (max_over_time(aws_ec2_status_check_failed_sum[10m])) or (avg by (instance_id) (max_over_time(aws_ec2_cpuutilization_average[10m])) * 0)",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "NetIn",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "max by (instance_id) (max_over_time(aws_ec2_network_in_sum[10m])) or (avg by (instance_id) (max_over_time(aws_ec2_cpuutilization_average[10m])) * 0)",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "NetOut",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "max by (instance_id) (max_over_time(aws_ec2_network_out_sum[10m])) or (avg by (instance_id) (max_over_time(aws_ec2_cpuutilization_average[10m])) * 0)",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "job": true, "__name__": true,
              "instance": true, "monitor": true, "environment": true,
              "dimension_name": true, "dimension_value": true
            },
            "renameByName": {
              "instance_id":   "Instance ID",
              "Value #CPU":    "CPU %",
              "Value #Health": "Health",
              "Value #NetIn":  "Network In",
              "Value #NetOut": "Network Out"
            },
            "indexByName": {
              "Instance ID": 0,
              "Health":      1,
              "CPU %":       2,
              "Network In":  3,
              "Network Out": 4
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [{ "config": { "id": "isNull", "options": {} }, "fieldName": "CPU %", "type": "exclude" }],
            "match": "any",
            "type": "exclude"
          }
        }
      ]
    },

    {
      "id": 30, "type": "row",
      "title": "📈 CPU Trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },

    {
      "id": 31,
      "title": "CPU % per Instance Over Time",
      "description": "Instance disappears from chart when stopped — reappears when started",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "avg by (instance_id) (aws_ec2_cpuutilization_average)",
        "legendFormat": "{{ instance_id }}"
      }]
    },

    {
      "id": 32,
      "title": "Running Instance Count Over Time",
      "description": "Drops when an instance is stopped, rises when started",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": { "lineWidth": 2, "fillOpacity": 20, "lineInterpolation": "stepAfter" }
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "expr": "count(count by (instance_id) (aws_ec2_cpuutilization_average))",
        "legendFormat": "Running Instances"
      }]
    }

  ]
}
