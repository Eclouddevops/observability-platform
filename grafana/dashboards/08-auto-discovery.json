{
  "uid": "ec2-auto-discovery",
  "title": "🔍 EC2 Auto-Discovery",
  "description": "Live view of all auto-discovered EC2 instances across all regions",
  "tags": ["ec2", "auto-discovery", "aws"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "row",
      "title": "🔍 Discovery Status",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Total EC2 Discovered",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "autodiscovery_instances_total", "legendFormat": "Total" }]
    },
    {
      "id": 3,
      "title": "Monitored (Node Exporter UP)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "autodiscovery_instances_monitored", "legendFormat": "Monitored" }]
    },
    {
      "id": 4,
      "title": "Missing Node Exporter",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 3 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "autodiscovery_instances_missing", "legendFormat": "Missing" }]
    },
    {
      "id": 5,
      "title": "Discovery Runs Today",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "increase(autodiscovery_runs_total[24h])", "legendFormat": "Runs" }]
    },
    {
      "id": 6,
      "title": "Last Discovery",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "autodiscovery_last_run_timestamp * 1000", "legendFormat": "Last Run" }]
    },
    {
      "id": 7,
      "title": "Discovery Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "increase(autodiscovery_errors_total[24h]) or vector(0)", "legendFormat": "Errors" }]
    },
    {
      "id": 10, "type": "row",
      "title": "📈 Discovery Trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 11,
      "title": "Instance Count Over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "autodiscovery_instances_total", "legendFormat": "Total Discovered" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "autodiscovery_instances_monitored", "legendFormat": "Monitored (NE UP)" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "autodiscovery_instances_missing", "legendFormat": "Missing Node Exporter" }
      ]
    },
    {
      "id": 12,
      "title": "Auto-Discovery Agent — CPU & Memory",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "rate(process_cpu_seconds_total{job=\"auto-discovery\"}[5m]) * 100", "legendFormat": "CPU %" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "process_resident_memory_bytes{job=\"auto-discovery\"} / 1024 / 1024", "legendFormat": "Memory MB" }
      ]
    },
    {
      "id": 20, "type": "row",
      "title": "🖥️ Discovered EC2 Instances",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 21,
      "title": "All Auto-Discovered EC2 Instances",
      "description": "All instances from AWS — CPU & Health via CloudWatch. No Node Exporter needed.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Instance Name", "desc": false }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Health" },
            "properties": [
              { "id": "custom.width", "value": 130 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [{
                "type": "value",
                "options": {
                  "0": { "text": "🟢 Healthy",     "color": "green", "index": 0 },
                  "1": { "text": "🔴 Failed",       "color": "red",   "index": 1 }
                }
              }]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green",  "value": 0  },
                { "color": "yellow", "value": 70 },
                { "color": "red",    "value": 90 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Network In" },
            "properties": [{ "id": "unit", "value": "bytes" }, { "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "Network Out" },
            "properties": [{ "id": "unit", "value": "bytes" }, { "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "Instance ID" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      },
      "targets": [
        {
          "refId": "CPU",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "aws_ec2_cpuutilization_average",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "Health",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "aws_ec2_status_check_failed_sum or (aws_ec2_cpuutilization_average * 0)",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "NetIn",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "aws_ec2_network_in_sum or (aws_ec2_cpuutilization_average * 0)",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "NetOut",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "aws_ec2_network_out_sum or (aws_ec2_cpuutilization_average * 0)",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "job": true, "__name__": true,
              "instance": true, "monitor": true, "environment": true,
              "dimension_name": true, "dimension_value": true
            },
            "renameByName": {
              "instance_id":   "Instance ID",
              "Value #CPU":    "CPU %",
              "Value #Health": "Health",
              "Value #NetIn":  "Network In",
              "Value #NetOut": "Network Out"
            },
            "indexByName": {
              "Instance ID": 0,
              "Health":      1,
              "CPU %":       2,
              "Network In":  3,
              "Network Out": 4
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [{ "config": { "id": "isNull", "options": {} }, "fieldName": "CPU %", "type": "exclude" }],
            "match": "any",
            "type": "exclude"
          }
        }
      ]
    }
  ]
}
